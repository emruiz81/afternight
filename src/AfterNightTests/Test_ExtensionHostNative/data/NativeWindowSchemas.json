  "every_kind": [
    {
      "id": "window_meta",
      "type": "meta",
      "panel_variant": "native",
      "controls_panel_width": 420,
      "header_progress": false,
      "tool_configuration": {
        "settings_key": "example_tool_dir",
        "label": "Example Tool",
        "primary_executable": "exampletool",
        "not_configured_text": "Example Tool is not configured."
      }
    },
    {
      "id": "credits",
      "type": "info",
      "text": "Made by the examples."
    },
    {
      "id": "loose_value",
      "type": "float",
      "label": "Loose Value",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.1
    },
    {
      "id": "loose_note",
      "type": "info",
      "text": "A note outside any section."
    },
    {
      "id": "main_tabs",
      "type": "tabs"
    },
    {
      "id": "tab_basic",
      "type": "tab",
      "label": "Basic"
    },
    {
      "id": "basics",
      "type": "section",
      "label": "Basics",
      "tooltip": "The basic settings"
    },
    {
      "id": "strength",
      "type": "float",
      "label": "Strength",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "tooltip": "How strong"
    },
    {
      "id": "gain",
      "type": "double",
      "label": "Gain",
      "default": 0.25,
      "min": -1.0,
      "max": 1.0,
      "step": 0.001,
      "tracking": false
    },
    {
      "id": "iterations",
      "type": "int",
      "label": "Iterations",
      "default": 5,
      "min": 1,
      "max": 20,
      "step": 2,
      "preview_invalidates": true
    },
    {
      "id": "enabled_flag",
      "type": "bool",
      "label": "Enabled",
      "default": true,
      "tooltip": "Turn it on"
    },
    {
      "id": "mode",
      "type": "choice",
      "label": "Mode",
      "default": "quality",
      "options": [
        [
          "Fast",
          "fast"
        ],
        [
          "Quality",
          "quality"
        ],
        [
          "Best",
          "best"
        ]
      ],
      "inline_actions": [
        {
          "id": "refresh_preview",
          "label": "Update Preview",
          "button_role": "primary",
          "tooltip": "Refresh the preview",
          "preview_refresh_role": true
        }
      ]
    },
    {
      "id": "note",
      "type": "string",
      "label": "Note",
      "default": "hello",
      "placeholder": "Type a note"
    },
    {
      "id": "mix",
      "type": "percentage_mix_label",
      "source": "gain",
      "left_label": "Ha",
      "right_label": "OIII",
      "tooltip": "The blend"
    },
    {
      "id": "strength_description",
      "type": "value_description_label",
      "source": "strength",
      "decimals": 3,
      "prefix": "x",
      "suffix": "!",
      "ranges": [
        [
          0.0,
          0.5,
          "Low"
        ],
        [
          0.5,
          2.0,
          "High"
        ]
      ]
    },
    {
      "id": "conditional",
      "type": "section",
      "label": "Conditional",
      "presentation": "collapsible",
      "visible_when": "enabled_flag == true"
    },
    {
      "id": "conditional_value",
      "type": "float",
      "label": "Conditional Value",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.25,
      "enabled_when": {
        "param": "mode",
        "equals": "quality"
      }
    },
    {
      "id": "danger_action",
      "type": "button",
      "label": "Reset Stuff",
      "role": "danger",
      "enabled_when": "mode != fast"
    },
    {
      "id": "preview_status_banner",
      "type": "info",
      "preview_status": true,
      "text": "Preview update needed.",
      "stale_text": "The preview is stale.",
      "ready_text": "The preview is current.",
      "updating_text": "The preview is updating."
    },
    {
      "id": "careful",
      "type": "info",
      "tone": "warning",
      "text": "Careful."
    },
    {
      "id": "tab_tools",
      "type": "tab",
      "label": "Tools"
    },
    {
      "id": "curve",
      "type": "curve_editor",
      "label": "Curve",
      "default": [
        [
          0.0,
          0.0
        ],
        [
          0.25,
          0.4
        ],
        [
          1.0,
          1.0
        ]
      ],
      "interpolation": "linear",
      "grid": false,
      "tooltip": "The curve"
    },
    {
      "id": "frame_histogram",
      "type": "rt_histogram",
      "height": 180,
      "show_clipping_info_control": false
    },
    {
      "id": "second_histogram",
      "type": "rt_histogram",
      "height": 120,
      "local_channel_normalization": true,
      "histogram_areas": true
    },
    {
      "id": "vectors",
      "type": "vector_slope",
      "label": "Vectors",
      "height": 160
    },
    {
      "id": "reference",
      "type": "view_selector",
      "label": "Reference",
      "placeholder": "Choose a reference",
      "channel_filter": [
        1,
        3
      ],
      "match_target_geometry": true,
      "exclude_target": true
    },
    {
      "id": "target",
      "type": "target_selector",
      "label": "Target",
      "tooltip": "The image to change"
    },
    {
      "id": "mask",
      "type": "manual_mask_editor",
      "label": "Mask",
      "use_param": "use_mask",
      "use_label": "Use the mask",
      "display_param": "mode",
      "display_value": "best",
      "brush_size": 40
    },
    {
      "id": "end",
      "type": "end_tabs"
    },
    {
      "id": "after_tabs",
      "type": "section",
      "label": "After"
    },
    {
      "id": "do_it",
      "type": "action",
      "label": "Do It",
      "variant": "primary"
    },
    {
      "id": "no_type"
    },
    {
      "type": "float",
      "label": "No Id"
    },
    {
      "id": "unsupported",
      "type": "color"
    }
