{
  "an_custom_ui_demo": [
    {
      "id": "window_meta",
      "type": "meta",
      "panel_variant": "custom"
    },
    {
      "id": "panel_banner",
      "type": "section",
      "label": "Film Fade Studio"
    },
    {
      "id": "panel_summary",
      "type": "info",
      "tone": "warning",
      "text": "This demo intentionally leans into a more editorial, studio style layout. It is execute-only, uses the same native AfterNight controls under the hood, and should feel clearly different from the standard process panels."
    },
    {
      "id": "strength",
      "type": "double",
      "label": "Fade Amount",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "id": "iterations",
      "type": "int",
      "label": "Layer Passes",
      "default": 4,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "id": "sigma",
      "type": "double",
      "label": "Glow Radius",
      "default": 1.2,
      "min": 0.1,
      "max": 5.0,
      "step": 0.1
    },
    {
      "id": "use_mask",
      "type": "bool",
      "label": "Use Mask",
      "default": true
    },
    {
      "id": "mode",
      "type": "choice",
      "label": "Render Strategy",
      "default": "fast",
      "options": [
        [
          "Fast",
          "fast"
        ],
        [
          "Quality",
          "quality"
        ]
      ]
    },
    {
      "id": "output_section",
      "type": "section",
      "label": "Delivery"
    },
    {
      "id": "output_hint",
      "type": "info",
      "tone": "info",
      "text": "Output fields stay in the panel so the demo still exercises typed parameter capture and settings-backed defaults, but without any RT preview surface."
    },
    {
      "id": "output_name",
      "type": "string",
      "label": "Rendered Name",
      "default": "Custom UI Demo",
      "placeholder": "Film fade render"
    },
    {
      "id": "export_dir",
      "type": "string",
      "label": "Export Folder",
      "default": "/tmp/output"
    },
    {
      "id": "quality_preset",
      "type": "choice",
      "label": "Preset",
      "default": "balanced",
      "options": [
        [
          "Fast",
          "fast"
        ],
        [
          "Balanced",
          "balanced"
        ],
        [
          "Best",
          "best"
        ]
      ]
    }
  ],
  "an_echo_demo": [
    {
      "id": "compatibility_banner",
      "type": "section",
      "label": "Compatibility Echo"
    },
    {
      "id": "compatibility_summary",
      "type": "info",
      "text": "Inverts the active image (photographic negative) and annotates the result with host session and view metadata. This validates bundled discovery, ProcessWindow launch, and ViewRef compatibility without using preview."
    }
  ],
  "an_rt_preview_demo": [
    {
      "id": "window_meta",
      "type": "meta",
      "panel_variant": "native",
      "sub_area": true,
      "sub_area_size": [
        800,
        600
      ],
      "sub_area_label": "Preview: Contrast Demo",
      "preview_autostretch": true,
      "target_channel_filter": [
        1,
        3
      ],
      "target_selector": true
    },
    {
      "id": "preview_banner",
      "type": "section",
      "label": "RT Preview"
    },
    {
      "id": "preview_summary",
      "type": "info",
      "tone": "info",
      "text": "This is the single real-time preview demo. Change the sliders and the preview refreshes automatically. Use the Preview area checkbox in the RT preview toolbar to limit processing to a selected ROI."
    },
    {
      "id": "strength",
      "type": "float",
      "label": "Contrast Strength",
      "default": 0.45,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "id": "lift",
      "type": "float",
      "label": "Black Point Lift",
      "default": 0.0,
      "min": -0.25,
      "max": 0.25,
      "step": 0.01
    },
    {
      "id": "mode",
      "type": "choice",
      "label": "Mode",
      "default": "balanced",
      "options": [
        [
          "Balanced",
          "balanced"
        ],
        [
          "Punchy",
          "punchy"
        ],
        [
          "Gentle",
          "gentle"
        ]
      ]
    },
    {
      "id": "preserve_background",
      "type": "bool",
      "label": "Preserve Background",
      "default": true
    }
  ],
  "an_sequence_workflow_demo": [
    {
      "id": "window_meta",
      "type": "meta",
      "panel_variant": "workflow"
    },
    {
      "id": "workflow_overview",
      "type": "info",
      "text": "Creates synthetic calibration and light frames, runs the native workflow SDK calibration, registration, and stacking domains, and writes a report through WorkflowContext."
    },
    {
      "id": "synthetic_frames",
      "type": "int",
      "label": "Synthetic Frames",
      "default": 3,
      "min": 1,
      "max": 12
    },
    {
      "id": "output_name",
      "type": "string",
      "label": "Report File",
      "default": "sequence_workflow_report.txt"
    }
  ],
  "an_standalone_preview_demo": [
    {
      "id": "window_meta",
      "type": "meta",
      "panel_variant": "native",
      "preview_surface": false
    },
    {
      "id": "standalone_section",
      "type": "section",
      "label": "Standalone Window"
    },
    {
      "id": "standalone_summary",
      "type": "info",
      "tone": "info",
      "text": "At runtime this demo hides the stock process shell, opens its own PySide6 dialog, reads the active image through ViewRef, and commits the result back with ui.commit_image()."
    }
  ],
