<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest every executable of the product carries on Windows, merged into the one the toolset embeds.
  It declares the process long-path aware, so a path past the old 260-character limit - an output in a deep directory,
  with the pending name a write adds to it - reaches the file system wherever Windows has long paths turned on.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
