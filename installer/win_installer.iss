; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "AfterNight"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "Ezequiel Ruiz"
#define MyAppExeName "AfterNight.exe"
#define MyAppId "{9D5A6D59-2A02-4464-A8CA-939FCDA20912}"

[Setup]

AppId={{9D5A6D59-2A02-4464-A8CA-939FCDA20912}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
#ifdef ADMIN
PrivilegesRequired=admin
#else
PrivilegesRequired=lowest
#endif
;PrivilegesRequiredOverridesAllowed=dialog
OutputDir=.\

#ifdef ADMIN
OutputBaseFilename=AfterNightSetup_{#MyAppVersion}
#else
OutputBaseFilename=AfterNightUserSetup_{#MyAppVersion}
#endif
Compression=lzma
SolidCompression=yes
WizardStyle=modern
WizardSmallImageFile=..\icons\afternight_icon_256x256_blue.bmp
WizardImageFile=.\M83_banner.bmp
UninstallDisplayIcon={app}\bin\{#MyAppExeName}
SetupIconFile=..\icons\afternight_icon_512x512_blue.ico
VersionInfoProductName={#MyAppName}
VersionInfoCopyright="Ezequiel Ruiz <ezequiel.ruiz@gmail.com>"
VersionInfoVersion=1.0.0.0
;LicenseFile=.\license.txt

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; The deployed directory is the product: the engine and its G'MIC adapter, the private RAW runtime the engine
; imports, AfterNightPlatform (the logger and the crash handler every binary loads), the consumer runtime, the
; libraries, the application, both extension hosts, the command-line tool, the runtime backend, the style plugin and
; the crash handler process. Development builds also leave beside it the engine's build record, the test, fuzz,
; benchmark and RAW qualification tools, the measurement driver, the reference libraries only the library parity
; suite imports, the optional Python adapter, the opt-in GPU backend and the Debug builds of the private RAW runtime;
; build/scripts/tools/check_installer_payload.py proves each is excluded and that the product's own libraries, the
; platform library among them, are not.
Source: "..\bin\msvc\release\*"; DestDir: "{app}"; Excludes: "*.gitkeep,gtest.dll,*.log,*.pdb,.engine-instrumentation,Test_*,Fuzz_*,Raw*Bench*,Raw*Oracle*,RawRuntimeProbe*,RawNativeTests*,AfterNightEngineBench*,AfterNightWorkflowDriver*,AfterNightEnginePythonAdapter*,AfterNightEngineOpenClBackend*,afternight_libraw_rd.*,afternight_rawspeedd.*,opencv_*,raw_r*,lcms2-2*"; Flags: ignoreversion recursesubdirs

; Documentation (release builds require the pre-built HTML artifact; local builds include it when present)
#ifdef REQUIRE_DOCS
Source: "..\docs\user-guide\site\*"; DestDir: "{app}\docs"; Flags: ignoreversion recursesubdirs
#else
Source: "..\docs\user-guide\site\*"; DestDir: "{app}\docs"; Flags: ignoreversion recursesubdirs skipifsourcedoesntexist
#endif

[Dirs]
#ifdef ADMIN
; Grants full control (read/write/execute) to all users for the installation folder
Name: "{app}"; Permissions: everyone-full
#endif

[UninstallDelete]
Type: filesandordirs; Name: "{app}"

[Registry]
#ifdef ADMIN
Root: HKLM; Subkey: "Software\{#MyAppName}"; ValueType: string; ValueName: "Version"; ValueData: "{#MyAppVersion}"; Flags: uninsdeletekey
#else
Root: HKCU; Subkey: "Software\{#MyAppName}"; ValueType: string; ValueName: "Version"; ValueData: "{#MyAppVersion}"; Flags: uninsdeletekey
#endif

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autoprograms}\{#MyAppName} User Guide"; Filename: "{app}\docs\index.html"; Flags: createonlyiffileexists
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
[Code]
var
  PreviousVersion: string;
  UninstallString: string;
  ec: Integer;  // Exit code variable

function InitializeSetup(): Boolean;
begin
  // Check if the application is already installed
  #ifdef ADMIN
  if RegQueryStringValue(HKLM, 'Software\{#MyAppName}', 'Version', PreviousVersion) then
  #else
  if RegQueryStringValue(HKCU, 'Software\{#MyAppName}', 'Version', PreviousVersion) then
  #endif
  begin
    // Compare versions
    if CompareStr(PreviousVersion, '{#MyAppVersion}') < 0 then
    begin
      // An older version is installed, find and run the uninstaller
      #ifdef ADMIN
      if RegQueryStringValue(HKLM, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppId}_is1', 'UninstallString', UninstallString) then
      #else
      if RegQueryStringValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppId}_is1', 'UninstallString', UninstallString) then
      #endif
      begin
        MsgBox('A previous version (' + PreviousVersion + ') is installed. It will now be uninstalled.', mbInformation, MB_OK);
        // Run the uninstaller for the previous version
        if ShellExec('', UninstallString, '', '', SW_SHOW, ewWaitUntilTerminated, ec) then
        begin
          // Check if uninstallation succeeded (exit code 0 usually indicates success)
          if ec = 0 then
          begin
            Result := True;  // Proceed with installation
          end
          else
          begin
            MsgBox('Uninstallation failed with exit code: ' + IntToStr(ec), mbError, MB_OK);
            Result := False;  // Abort installation if uninstallation fails
          end;
        end
        else
        begin
          MsgBox('Error launching the uninstaller.', mbError, MB_OK);
          Result := False;  // Abort installation if we couldn't launch the uninstaller
        end;
      end
      else
      begin
        MsgBox('Uninstaller not found in registry.', mbError, MB_OK);
        Result := False;
      end;
    end
    else if CompareStr(PreviousVersion, '{#MyAppVersion}') = 0 then
    begin
      // Prompt user to uninstall the existing version
      if MsgBox('The same version (' + PreviousVersion + ') is already installed. Would you like to uninstall it first?', 
                 mbConfirmation, 
                 MB_YESNO) = IDYES then
      begin
        // Find the uninstaller string
        #ifdef ADMIN
        if RegQueryStringValue(HKLM, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppId}_is1', 'UninstallString', UninstallString) then
        #else
        if RegQueryStringValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppId}_is1', 'UninstallString', UninstallString) then
        #endif
        begin
          // Run the uninstaller for the current version
          if ShellExec('', UninstallString, '', '', SW_SHOW, ewWaitUntilTerminated, ec) then
          begin
            // Check if uninstallation succeeded (exit code 0 usually indicates success)
            if ec = 0 then
            begin
              Result := True;  // Proceed with installation
            end
            else
            begin
              MsgBox('Uninstallation failed with exit code: ' + IntToStr(ec), mbError, MB_OK);
              Result := False;  // Abort installation if uninstallation fails
            end;
          end
          else
          begin
            MsgBox('Error launching the uninstaller.', mbError, MB_OK);
            Result := False;  // Abort installation if we couldn't launch the uninstaller
          end;
        end
        else
        begin
          MsgBox('Uninstaller not found in registry.', mbError, MB_OK);
          Result := False;
        end;
      end
      else
      begin
        MsgBox('Installation cancelled by user.', mbInformation, MB_OK);
        Result := False;  // Cancel the installation
      end;
    end
    else
    begin
      // Newer version detected, proceed with the installation
      Result := True;
    end;
  end
  else
  begin
    // No previous version detected, proceed with the installation
    Result := True;
  end;
end;
