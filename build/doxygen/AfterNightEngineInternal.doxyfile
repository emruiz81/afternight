# Doxygen configuration for the AfterNightEngine implementation's internal interfaces.
#
# A private header is an interface too: one translation unit declares something there so that
# another can use it, and the reader of the second has nothing but the declaration to go on. So every
# declaration in a private header of the engine, the two optional adapters and the opt-in device
# backend carries documentation, and this configuration is the check that says so - the same
# generator and the same rule as the public reference, run over the implementation's headers.
#
# It asks for less than the public configuration does, deliberately. WARN_NO_PARAMDOC is off: an
# internal function states its intent, its invariants and any decision a reader could not recover
# from the code, which is what the documentation standard asks of implementation code, and a line
# per parameter of a private helper would mostly restate its signature. A parameter list that is
# documented has to be documented correctly, so WARN_IF_DOC_ERROR and WARN_IF_INCOMPLETE_DOC stay
# on: a @param naming an argument that no longer exists is stale documentation, and stale
# documentation is a defect.
#
# The implementation files themselves are not input. What a function body must explain - why this
# algorithm, which equation, what the boundary does - is a judgement no warning can make, so the
# engine's translation units are held to a module comment by check_engine_documentation.py and to
# the rest by review.
#
# Run it through build/scripts/tools/check_engine_documentation.py, which supplies the output
# directory, refuses the file if a setting below that makes it a check is turned around, and
# reports the diagnostics. Pass that script --output-dir to keep the generated internal reference.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "AfterNightEngine internals"
PROJECT_BRIEF          = "The implementation's private interfaces"
OUTPUT_DIRECTORY       = doxygen-internal-output
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = src/AfterNightEngine/src src/AfterNightEngineGmicAdapter/src src/AfterNightEnginePythonAdapter/src

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
DISTRIBUTE_GROUP_DOC   = NO

# The same four settings the public configuration guards, for the same reason: each one turned the
# other way hides a kind of undocumented declaration, and a hidden declaration is not reported.
# EXTRACT_STATIC is on here because a static function in a private header is shared by every unit
# that includes it, which is what makes it an interface rather than a detail of one file.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_NAMESPACES  = NO
INTERNAL_DOCS          = YES
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

INPUT                  = src/AfterNightEngine/src src/AfterNightEngineGmicAdapter/src src/AfterNightEnginePythonAdapter/src
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.inl
RECURSIVE              = YES
EXCLUDE_SYMLINKS       = YES

SOURCE_BROWSER         = NO
ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = NO

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = src/AfterNightEngine/include src/AfterNightEngine/src src/AfterNightEngineGmicAdapter/include src/AfterNightEnginePythonAdapter/include
PREDEFINED             = AFTERNIGHTENGINE_API= AFTERNIGHTENGINE_INTERFACE= AFTERNIGHTENGINEGMICADAPTER_API= AFTERNIGHTENGINEPYTHONADAPTER_API=
SKIP_FUNCTION_MACROS   = YES

# The opt-in device backend's implementation is read like the adapters'. These four lines go with the
# backend when its removal procedure runs.
INPUT                 += src/AfterNightEngineOpenClBackend/src
STRIP_FROM_INC_PATH   += src/AfterNightEngineOpenClBackend/src
INCLUDE_PATH          += src/AfterNightEngineOpenClBackend/include
PREDEFINED            += AFTERNIGHTENGINEOPENCLBACKEND_API=

CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
HAVE_DOT               = NO
