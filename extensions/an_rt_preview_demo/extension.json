{
  "id": "an.demo.rt_preview",
  "name": "RT Preview Demo",
  "version": "0.1.0",
  "development_only": true,
  "summary": "Bundled reference extension validating auto UI and RT preview flows.",
  "type": "python",
  "entry_point": "an_rt_preview_demo",
  "process_class": "RTPreviewDemoExtension",
  "category": "filters",
  "launch_mode": "single_image",
  "sdk_backend": "runtime",
  "package_format_version": 1,
  "protocol_version": 1,
  "sdk_version": 1,
  "python_compat": ">=3.14,<4",
  "dependencies": {
    "dependency_context": "shared_host",
    "shared_host_profile": "scientific_core"
  },
  "capabilities": {
    "execute": true,
    "preview": true,
    "preview_scaling": "decimated",
    "keep_open": true
  }
}
