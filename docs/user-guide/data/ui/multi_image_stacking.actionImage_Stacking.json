{
  "id": "multi_image_stacking.actionImage_Stacking",
  "window": "Image Stacking",
  "controls": [
    {"label": "Method", "kind": "combo", "object": "", "group": "Stacking Settings", "visible": true, "default": "Average", "options": ["Average", "Sum", "Maximum", "Minimum", "Median", "Auto-Adaptive Weighted Average"]},
    {"label": "Normalization", "kind": "combo", "object": "", "group": "Stacking Settings", "visible": true, "default": "None", "options": ["None", "Additive", "Multiplicative", "Additive With Scaling", "Multiplicative With Scaling", "Local"]},
    {"label": "Weighting", "kind": "combo", "object": "", "group": "Stacking Settings", "visible": true, "default": "None (Equal)", "options": ["None (Equal)", "FWHM", "Noise", "SNR", "Stars", "Exposure"]},
    {"label": "Scale Estimator", "kind": "combo", "object": "", "group": "Stacking Settings", "visible": true, "default": "IKSS", "options": ["IKSS", "MAD"]},
    {"label": "Comet Mode", "kind": "combo", "object": "", "group": "Stacking Settings", "visible": true, "default": "Stars", "options": ["Stars", "Comet"]},
    {"label": "Configure Local Normalization...", "kind": "button", "object": "", "group": "Stacking Settings", "visible": false, "default": ""},
    {"label": "Rejection Method", "kind": "combo", "object": "", "group": "Stacking Settings > Rejection Settings", "visible": false, "default": "Winsorized Sigma Clipping", "options": ["None", "Sigma Clipping", "MAD Clipping", "Median Sigma", "Winsorized Sigma Clipping", "Percentile", "GESDT", "Linear Fit"]},
    {"label": "Sigma Low", "kind": "spinbox", "object": "", "group": "Stacking Settings > Rejection Settings", "visible": false, "default": "3.000", "min": 0.001, "max": 1000, "step": 0.1, "decimals": 3},
    {"label": "Sigma High", "kind": "spinbox", "object": "", "group": "Stacking Settings > Rejection Settings", "visible": false, "default": "3.000", "min": 0.001, "max": 1000, "step": 0.1, "decimals": 3},
    {"label": "Save rejection maps", "kind": "check", "object": "", "group": "Stacking Settings > Rejection Settings", "visible": false, "default": "Off"},
    {"label": "Merge rejection maps", "kind": "check", "object": "", "group": "Stacking Settings > Rejection Settings", "visible": false, "default": "On"},
    {"label": "Name Template", "kind": "field", "object": "", "group": "Output", "visible": true, "default": "stacked_$filter.fit"},
    {"label": "Browse", "kind": "button", "object": "", "group": "Output", "visible": true, "default": ""},
    {"label": "64-bit", "kind": "check", "object": "", "group": "Output", "visible": true, "default": "Off"},
    {"label": "Open after stacking", "kind": "check", "object": "", "group": "Output", "visible": true, "default": "On"},
    {"label": "Sum exposure times", "kind": "check", "object": "", "group": "Output", "visible": true, "default": "Off"},
    {"label": "Stack Images", "kind": "button", "object": "", "group": "Output", "visible": true, "default": ""},
    {"label": "Add Files", "kind": "button", "object": "", "group": "Frames", "visible": true, "default": ""},
    {"label": "Add Folder", "kind": "button", "object": "", "group": "Frames", "visible": true, "default": ""},
    {"label": "Remove Selected", "kind": "button", "object": "", "group": "Frames", "visible": true, "default": ""},
    {"label": "Move frame up", "kind": "button", "object": "", "group": "Frames", "visible": true, "default": ""},
    {"label": "Move frame down", "kind": "button", "object": "", "group": "Frames", "visible": true, "default": ""},
    {"label": "Clear All", "kind": "button", "object": "", "group": "Frames", "visible": true, "default": ""},
    {"label": "Filter", "kind": "check", "object": "", "group": "Frame Groups > Group by", "visible": true, "default": "On"},
    {"label": "Session", "kind": "check", "object": "", "group": "Frame Groups > Group by", "visible": true, "default": "Off"},
    {"label": "Exposure", "kind": "check", "object": "", "group": "Frame Groups > Group by", "visible": true, "default": "Off"},
    {"label": "Tolerance", "kind": "spinbox", "object": "", "group": "Frame Groups > Group by", "visible": true, "default": "5.0", "min": 0, "max": 100, "step": 1, "decimals": 1, "suffix": "%"},
    {"label": "Limit Memory Usage", "kind": "check", "object": "", "group": "Advanced", "visible": false, "default": "On"},
    {"label": "Max Memory", "kind": "spinbox", "object": "", "group": "Advanced > Limit Memory Usage", "visible": false, "default": "1024", "min": 256, "max": 8184, "step": 1, "suffix": "MB"},
    {"label": "Debayer CFA", "kind": "check", "object": "", "group": "Advanced", "visible": false, "default": "Off"},
    {"label": "Pattern", "kind": "combo", "object": "", "group": "Advanced > Debayer CFA", "visible": false, "default": "Auto", "options": ["Auto", "RGGB", "BGGR", "GBRG", "GRBG"]},
    {"label": "Method", "kind": "combo", "object": "", "group": "Advanced > Debayer CFA", "visible": false, "default": "RCD", "options": ["Bilinear", "VNG4", "AHD", "AMaZE", "LMMSE", "RCD"]},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
