{
  "id": "color.actionPhotometric_Color_Calibration",
  "window": "Photometric Color Calibration <{image}>",
  "controls": [
    {"label": "Plate Solve...", "kind": "button", "object": "actionButton", "group": "", "visible": true, "default": ""},
    {"label": "Magnitude limit", "kind": "spinbox", "object": "magnitudeLimitSpin", "group": "", "visible": true, "default": "14.0", "min": 6, "max": 20, "step": 0.5, "decimals": 1},
    {"label": "Match radius (arcsec)", "kind": "spinbox", "object": "matchRadiusSpin", "group": "", "visible": true, "default": "5.0", "min": 0.5, "max": 20, "step": 0.5, "decimals": 1},
    {"label": "Apply background neutralization", "kind": "check", "object": "backgroundNeutralizationCheck", "group": "", "visible": true, "default": "On"},
    {"label": "Background ROI Override", "kind": "check", "object": "backgroundRoiGroupBox", "group": "", "visible": true, "default": "Off"},
    {"label": "Left", "kind": "spinbox", "object": "backgroundRoiLeftValue", "group": "Background ROI Override", "visible": true, "default": "0", "min": 0, "step": 1, "varies": ["max"]},
    {"label": "Top", "kind": "spinbox", "object": "backgroundRoiTopValue", "group": "Background ROI Override", "visible": true, "default": "0", "min": 0, "step": 1, "varies": ["max"]},
    {"label": "Width", "kind": "spinbox", "object": "backgroundRoiWidthValue", "group": "Background ROI Override", "visible": true, "min": 0, "step": 1, "varies": ["default", "max"]},
    {"label": "Height", "kind": "spinbox", "object": "backgroundRoiHeightValue", "group": "Background ROI Override", "visible": true, "min": 0, "step": 1, "varies": ["default", "max"]},
    {"label": "From Selection", "kind": "button", "object": "backgroundRoiSelectionButton", "group": "Background ROI Override", "visible": true, "default": "Off"},
    {"label": "Target image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Show matched stars", "kind": "check", "object": "showMatchedStars", "group": "", "visible": true, "default": "On"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
