{
  "id": "mask_generation.actionMask_Drawing",
  "window": "Mask Drawing <{image}>",
  "controls": [
    {"label": "Brush", "kind": "button", "object": "toolBrushButton", "group": "Tool", "visible": true, "default": "On"},
    {"label": "Eraser", "kind": "button", "object": "toolEraserButton", "group": "Tool", "visible": true, "default": "Off"},
    {"label": "Shape", "kind": "button", "object": "toolShapeButton", "group": "Tool", "visible": true, "default": "Off"},
    {"label": "Edit", "kind": "button", "object": "toolEditButton", "group": "Tool", "visible": true, "default": "Off"},
    {"label": "Fill", "kind": "button", "object": "toolFloodFillButton", "group": "Tool", "visible": true, "default": "Off"},
    {"label": "Gradient", "kind": "button", "object": "toolGradientFillButton", "group": "Tool", "visible": true, "default": "Off"},
    {"label": "Tip Shape", "kind": "combo", "object": "", "group": "Brush", "visible": true, "default": "Round", "options": ["Round", "Square"]},
    {"label": "Size", "kind": "spinbox", "object": "", "group": "Brush", "visible": true, "default": "24", "min": 1, "max": 200, "step": 1, "slider": true},
    {"label": "Hardness", "kind": "spinbox", "object": "", "group": "Brush", "visible": true, "default": "1.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Opacity", "kind": "spinbox", "object": "", "group": "Brush", "visible": true, "default": "1.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Flow", "kind": "spinbox", "object": "", "group": "Brush", "visible": true, "default": "1.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Spacing", "kind": "spinbox", "object": "", "group": "Brush", "visible": true, "default": "0.25", "min": 0.01, "max": 1, "step": 0.01, "decimals": 2, "slider": true},
    {"label": "Stabilization", "kind": "spinbox", "object": "stabilizationSpin", "group": "Brush", "visible": true, "default": "0.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2},
    {"label": "Blend Mode", "kind": "combo", "object": "", "group": "Brush", "visible": true, "default": "Normal", "options": ["Normal", "Multiply", "Screen", "Overlay"]},
    {"label": "Shape", "kind": "combo", "object": "shapeTypeCombo", "group": "Shapes", "visible": true, "default": "Rectangle", "options": ["Rectangle", "Ellipse", "Circle", "Polygon", "Line"]},
    {"label": "Feather", "kind": "spinbox", "object": "", "group": "Shapes", "visible": true, "default": "0.0", "min": 0, "max": 100, "step": 0.5, "decimals": 1},
    {"label": "Filled", "kind": "check", "object": "", "group": "Shapes", "visible": true, "default": "On"},
    {"label": "Mask View", "kind": "combo", "object": "maskPreviewModeCombo", "group": "Preview", "visible": true, "default": "Red", "options": ["Red", "Green", "Blue", "Amber", "Grayscale", "Checkerboard"]},
    {"label": "Import Mask...", "kind": "button", "object": "importMaskButton", "group": "Mask File", "visible": true, "default": ""},
    {"label": "Export Mask...", "kind": "button", "object": "exportMaskButton", "group": "Mask File", "visible": true, "default": ""},
    {"label": "Undo", "kind": "button", "object": "", "group": "History", "visible": true, "default": ""},
    {"label": "Redo", "kind": "button", "object": "", "group": "History", "visible": true, "default": ""},
    {"label": "Clear", "kind": "button", "object": "", "group": "History", "visible": true, "default": ""},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "OK", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Cancel", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
