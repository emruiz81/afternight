{
  "id": "multi_image_stacking.actionImage_Integration_Lite",
  "window": "Image Integration Lite",
  "controls": [
    {"label": "Output", "kind": "field", "object": "liteOutputDirectoryEdit", "group": "Setup", "visible": true, "default": ""},
    {"label": "Browse", "kind": "button", "object": "liteBrowseOutputButton", "group": "Setup", "visible": true, "default": ""},
    {"label": "Reprocess existing outputs", "kind": "check", "object": "liteReprocessExistingCheck", "group": "Setup", "visible": true, "default": "Off"},
    {"label": "Open results when complete", "kind": "check", "object": "liteOpenResultsCheck", "group": "Setup", "visible": true, "default": "On"},
    {"label": "Limit memory usage", "kind": "check", "object": "liteLimitMemoryCheck", "group": "Setup", "visible": true, "default": "Off"},
    {"label": "Limit memory usage", "kind": "spinbox", "object": "liteMaxMemorySpin", "group": "Setup", "visible": true, "default": "2048", "min": 512, "max": 1048576, "step": 1, "suffix": "MB"},
    {"label": "CPU Threads", "kind": "spinbox", "object": "liteMaxParallelThreadsSpin", "group": "Setup", "visible": true, "min": 1, "step": 1, "varies": ["default", "max"]},
    {"label": "Matching", "kind": "combo", "object": "liteCalibrationCombo", "group": "Processing Settings > Calibration: Automatic, flat auto-level", "visible": false, "default": "Automatic", "options": ["Automatic", "Strict metadata match", "Adaptive"]},
    {"label": "Optimize dark frames", "kind": "check", "object": "liteDarkOptimizationCheck", "group": "Processing Settings > Calibration: Automatic, flat auto-level", "visible": false, "default": "Off"},
    {"label": "Normalize master flat", "kind": "check", "object": "liteFlatAutoLevelCheck", "group": "Processing Settings > Calibration: Automatic, flat auto-level", "visible": false, "default": "On"},
    {"label": "Transform", "kind": "combo", "object": "liteTransformationCombo", "group": "Processing Settings > Registration: Homography, auto reference", "visible": false, "default": "Homography", "options": ["Similarity", "Affine", "Homography", "Polynomial 2", "Polynomial 3", "Polynomial 4", "Auto"]},
    {"label": "Auto-select reference", "kind": "check", "object": "liteAutoReferenceCheck", "group": "Processing Settings > Registration: Homography, auto reference", "visible": false, "default": "On"},
    {"label": "Auto crop to common area", "kind": "check", "object": "liteAutoCropCheck", "group": "Processing Settings > Registration: Homography, auto reference", "visible": false, "default": "Off"},
    {"label": "Lights", "kind": "combo", "object": "liteNormalizationCombo", "group": "Processing Settings > Normalization: Global Additive Scaling", "visible": false, "default": "Global Additive Scaling", "options": ["Global Additive Scaling", "Global Additive", "Global Multiplicative Scaling", "Global Multiplicative", "Local Normalization", "None"]},
    {"label": "Method", "kind": "combo", "object": "liteStackMethodCombo", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "Average", "options": ["Average", "Sum", "Maximum", "Minimum", "Median", "Auto-Adaptive Weighted Average"]},
    {"label": "Rejection", "kind": "combo", "object": "liteRejectionMethodCombo", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "Auto", "options": ["Auto", "None", "Sigma Clipping", "MAD Clipping", "Median Sigma", "Winsorized Sigma Clipping", "Percentile", "GESDT", "Linear Fit"]},
    {"label": "Sigma Low", "kind": "spinbox", "object": "liteRejectionLowSpin", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "3.00", "min": 0.01, "max": 10, "step": 0.1, "decimals": 2},
    {"label": "Sigma High", "kind": "spinbox", "object": "liteRejectionHighSpin", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "3.00", "min": 0.01, "max": 10, "step": 0.1, "decimals": 2},
    {"label": "Weighting", "kind": "combo", "object": "liteWeightingCombo", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "None", "options": ["None", "Number of stars", "Weighted FWHM", "Noise"]},
    {"label": "Plate solve final masters", "kind": "check", "object": "liteSolveFinalMasterCheck", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "Off"},
    {"label": "Enable drizzle", "kind": "check", "object": "liteDrizzleEnabledCheck", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "Off"},
    {"label": "Drizzle scale", "kind": "combo", "object": "liteDrizzleScaleCombo", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "2x", "options": ["2x", "3x"]},
    {"label": "Drizzle pixfrac", "kind": "combo", "object": "liteDrizzlePixelFractionCombo", "group": "Processing Settings > Stacking: Average, Auto, final solve off, drizzle off", "visible": false, "default": "0.9", "options": ["0.9", "0.8", "1.0"]},
    {"label": "Add as", "kind": "combo", "object": "liteImportTypeCombo", "group": "Frames", "visible": true, "default": "Auto-detect", "options": ["Auto-detect", "Light", "Flat", "Dark", "Dark Flat", "Bias"]},
    {"label": "Add Files", "kind": "button", "object": "liteAddFilesButton", "group": "Frames", "visible": true, "default": ""},
    {"label": "Add Folder", "kind": "button", "object": "liteAddFolderButton", "group": "Frames", "visible": true, "default": ""},
    {"label": "Change Type", "kind": "button", "object": "liteChangeFrameTypeButton", "group": "Frames", "visible": true, "default": ""},
    {"label": "Light", "kind": "action", "object": "", "group": "Frames > Change Type", "visible": true, "default": ""},
    {"label": "Flat", "kind": "action", "object": "", "group": "Frames > Change Type", "visible": true, "default": ""},
    {"label": "Dark", "kind": "action", "object": "", "group": "Frames > Change Type", "visible": true, "default": ""},
    {"label": "Dark Flat", "kind": "action", "object": "", "group": "Frames > Change Type", "visible": true, "default": ""},
    {"label": "Bias", "kind": "action", "object": "", "group": "Frames > Change Type", "visible": true, "default": ""},
    {"label": "Clear All", "kind": "button", "object": "liteClearAllButton", "group": "Frames", "visible": true, "default": ""},
    {"label": "Run Integration", "kind": "button", "object": "liteRunIntegrationButton", "group": "", "visible": true, "default": ""},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Open Full Process", "kind": "button", "object": "liteOpenFullProcessButton", "group": "", "visible": true, "default": ""}
  ]
}
