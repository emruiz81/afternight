{
  "id": "sensor_calibration.actionImage_Calibration",
  "window": "Image Calibration",
  "controls": [
    {"label": "Bias Master", "kind": "check", "object": "biasGroupBox", "group": "", "visible": true, "default": "Off"},
    {"label": "...", "kind": "button", "object": "biasFileButton", "group": "Bias Master", "visible": true, "default": ""},
    {"label": "Dark Master", "kind": "check", "object": "darkGroupBox", "group": "", "visible": true, "default": "Off"},
    {"label": "...", "kind": "button", "object": "darkFileButton", "group": "Dark Master", "visible": true, "default": ""},
    {"label": "Enable dark optimization", "kind": "check", "object": "darkOptimizationCheck", "group": "Dark Master > Advanced Dark Settings", "visible": false, "default": "Off"},
    {"label": "Dark scaling", "kind": "spinbox", "object": "darkMultiplicationFactorValue", "group": "Dark Master > Advanced Dark Settings", "visible": false, "default": "1.00", "min": 0.1, "max": 10, "step": 0.1, "decimals": 2},
    {"label": "Enable cosmetic correction", "kind": "check", "object": "cosmeticCorrectionGroupBox", "group": "Dark Master > Advanced Dark Settings", "visible": false, "default": "Off"},
    {"label": "Cold sigma", "kind": "check", "object": "coldSigmaCheck", "group": "Dark Master > Advanced Dark Settings > Enable cosmetic correction", "visible": false, "default": "On"},
    {"label": "Cold sigma", "kind": "spinbox", "object": "coldSigmaValue", "group": "Dark Master > Advanced Dark Settings > Enable cosmetic correction", "visible": false, "default": "3.000", "min": 0, "max": 99.99, "step": 0.1, "decimals": 3},
    {"label": "Hot sigma", "kind": "check", "object": "hotSigmaCheck", "group": "Dark Master > Advanced Dark Settings > Enable cosmetic correction", "visible": false, "default": "On"},
    {"label": "Hot sigma", "kind": "spinbox", "object": "hotSigmaValue", "group": "Dark Master > Advanced Dark Settings > Enable cosmetic correction", "visible": false, "default": "3.000", "min": 0, "max": 99.99, "step": 0.1, "decimals": 3},
    {"label": "Auto-estimate", "kind": "button", "object": "estimateCosmeticCorrectionButton", "group": "Dark Master > Advanced Dark Settings > Enable cosmetic correction", "visible": false, "default": ""},
    {"label": "Flat Master", "kind": "check", "object": "flatGroupBox", "group": "", "visible": true, "default": "Off"},
    {"label": "...", "kind": "button", "object": "flatFileButton", "group": "Flat Master", "visible": true, "default": ""},
    {"label": "Normalize flat master automatically", "kind": "check", "object": "normalizeFlatsCheck", "group": "Flat Master > Advanced Flat Settings", "visible": false, "default": "On"},
    {"label": "...", "kind": "button", "object": "outputDirectoryButton", "group": "Output Execution", "visible": true, "default": ""},
    {"label": "Use source filename", "kind": "check", "object": "preserveOriginalNameCheck", "group": "Output Execution", "visible": true, "default": "On"},
    {"label": "Suffix", "kind": "field", "object": "filenameSuffixEdit", "group": "Output Execution", "visible": true, "default": "_cal"},
    {"label": "Format", "kind": "combo", "object": "outputFormatSelector", "group": "Output Execution", "visible": true, "default": "FITS (Recommended)", "options": ["FITS (Recommended)", "TIFF", "Original input format"]},
    {"label": "Precision", "kind": "combo", "object": "outputPrecisionSelector", "group": "Output Execution", "visible": true, "default": "32-bit float", "options": ["32-bit float", "64-bit double"]},
    {"label": "Pedestal (16-bit codes)", "kind": "spinbox", "object": "pedestalValue", "group": "Output Execution > Advanced Calibration Settings", "visible": false, "default": "0.0", "min": 0, "max": 10000, "step": 10, "decimals": 1},
    {"label": "Calibrate Images", "kind": "button", "object": "calibrateImagesButton", "group": "", "visible": true, "default": ""},
    {"label": "Add Files", "kind": "button", "object": "addFiles", "group": "Light Frames", "visible": true, "default": ""},
    {"label": "Add Folder", "kind": "button", "object": "addFolder", "group": "Light Frames", "visible": true, "default": ""},
    {"label": "Remove Selected", "kind": "button", "object": "removeSelected", "group": "Light Frames", "visible": true, "default": ""},
    {"label": "Move frame up", "kind": "button", "object": "moveUpButton", "group": "Light Frames", "visible": true, "default": ""},
    {"label": "Move frame down", "kind": "button", "object": "moveDownButton", "group": "Light Frames", "visible": true, "default": ""},
    {"label": "Clear All", "kind": "button", "object": "clearAll", "group": "Light Frames", "visible": true, "default": ""},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
