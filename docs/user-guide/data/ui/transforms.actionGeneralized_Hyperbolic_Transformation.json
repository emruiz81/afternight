{
  "id": "transforms.actionGeneralized_Hyperbolic_Transformation",
  "window": "Generalized Hyperbolic Transformation <{image}>",
  "controls": [
    {"label": "Zoom in", "kind": "toolbutton", "object": "zoomIn", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom out", "kind": "toolbutton", "object": "zoomOut", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom reset", "kind": "toolbutton", "object": "zoomReset", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Show grid", "kind": "toolbutton", "object": "gridButton", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Transfer curve", "kind": "toolbutton", "object": "transferCurve", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Show clipping info", "kind": "toolbutton", "object": "showClippingInfo", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Absolute scales", "kind": "toolbutton", "object": "localChannelNormalization", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Draw histogram areas", "kind": "toolbutton", "object": "showHistogramAreas", "group": "", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Plot resolution", "kind": "combo", "object": "plotResolution", "group": "", "visible": true, "default": "8-bit (256)", "options": ["6-bit (64)", "7-bit (128)", "8-bit (256)", "9-bit (512)", "10-bit (1024)", "12-bit (4096)", "14-bit (16K)", "16-bit (64K)", "100 levels", "1000 levels", "10000 levels"], "shared": "rt-preview"},
    {"label": "Channel", "kind": "combo", "object": "channelSelector2", "group": "", "visible": true, "default": "RGB", "options": ["RGB", "Red", "Green", "Blue", "Lightness", "Saturation", "Colour"]},
    {"label": "Human weighted luminance", "kind": "check", "object": "humanWeightedLuminance", "group": "", "visible": false, "default": "On"},
    {"label": "Colour clip", "kind": "combo", "object": "colourClipSelector", "group": "", "visible": false, "default": "Clip", "options": ["Clip", "Rescale"]},
    {"label": "Luminance coeffs", "kind": "combo", "object": "lumCoeffSourceSelector", "group": "", "visible": false, "default": "Default", "options": ["Default", "Image", "Manual"]},
    {"label": "R/G/B", "kind": "spinbox", "object": "lumCoeffRValue", "group": "", "visible": false, "default": "1.0000", "min": 0, "max": 10, "step": 0.1, "decimals": 4},
    {"label": "R/G/B", "kind": "spinbox", "object": "lumCoeffGValue", "group": "", "visible": false, "default": "1.0000", "min": 0, "max": 10, "step": 0.1, "decimals": 4},
    {"label": "R/G/B", "kind": "spinbox", "object": "lumCoeffBValue", "group": "", "visible": false, "default": "1.0000", "min": 0, "max": 10, "step": 0.1, "decimals": 4},
    {"label": "Transformation type", "kind": "combo", "object": "transformationTypeSelector", "group": "", "visible": true, "default": "Generalized Hyperbolic", "options": ["Generalized Hyperbolic", "Histogram Transformation", "Arcsinh", "Linear Stretch", "Image Inversion", "STF Transformation"]},
    {"label": "Invert", "kind": "check", "object": "invert", "group": "", "visible": true, "default": "Off"},
    {"label": "Linked STF", "kind": "check", "object": "linkedStf", "group": "", "visible": false, "default": "Off"},
    {"label": "Stretch factor(In(D+1))", "kind": "spinbox", "object": "stretchFactorValue", "group": "", "visible": true, "default": "0.0000", "min": 0, "max": 20, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Local intensity (b)", "kind": "spinbox", "object": "localIntensityValue", "group": "", "visible": true, "default": "0.0000", "min": -5, "max": 15, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Symmetry point (SP)", "kind": "spinbox", "object": "symmetryPointValue", "group": "", "visible": true, "default": "0.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Protect shadows (LP)", "kind": "spinbox", "object": "protectShadowsValue", "group": "", "visible": true, "default": "0.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Protect highlights (HP)", "kind": "spinbox", "object": "protectHighlightsValue", "group": "", "visible": true, "default": "1.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Black point (BP)", "kind": "spinbox", "object": "blackPointValue", "group": "", "visible": false, "default": "0.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "White point (WP)", "kind": "spinbox", "object": "whitePointValue", "group": "", "visible": false, "default": "1.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Pick from image point", "kind": "button", "object": "spFromImage", "group": "", "visible": true, "default": "Off"},
    {"label": "Pick from image area", "kind": "button", "object": "spFromImageArea", "group": "", "visible": true, "default": "Off"},
    {"label": "Pick from histogram point", "kind": "button", "object": "spFromHistogram", "group": "", "visible": true, "default": "Off"},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
