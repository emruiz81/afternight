{
  "id": "color.actionColor_Calibration_2",
  "window": "ColorCalibration <{image}>",
  "controls": [
    {"label": "Reference image", "kind": "combo", "object": "whiteReferenceImageSelector", "group": "White Reference", "visible": true, "default": "<--TARGET IMAGE-->", "options": ["<--TARGET IMAGE-->"]},
    {"label": "Lower Limit", "kind": "spinbox", "object": "whiteLowerLimitValue", "group": "White Reference", "visible": true, "default": "0.000000", "min": 0, "max": 1, "step": 0.05, "decimals": 6, "slider": true},
    {"label": "Upper Limit", "kind": "spinbox", "object": "whiteUpperLimitValue", "group": "White Reference", "visible": true, "default": "0.900000", "min": 0, "max": 1, "step": 0.05, "decimals": 6, "slider": true},
    {"label": "Region of interest", "kind": "check", "object": "whiteRoiGroupBox", "group": "White Reference", "visible": true, "default": "Off"},
    {"label": "Left", "kind": "spinbox", "object": "whiteRoiLeftValue", "group": "White Reference > Region of interest", "visible": true, "default": "0", "min": 0, "max": 99, "step": 1},
    {"label": "Top", "kind": "spinbox", "object": "whiteRoiTopValue", "group": "White Reference > Region of interest", "visible": true, "default": "0", "min": 0, "max": 99, "step": 1},
    {"label": "From Selection", "kind": "button", "object": "whiteRoiSelectionButton", "group": "White Reference > Region of interest", "visible": true, "default": "Off"},
    {"label": "Width", "kind": "spinbox", "object": "whiteRoiWidthValue", "group": "White Reference > Region of interest", "visible": true, "default": "0", "min": 0, "max": 99, "step": 1},
    {"label": "Height", "kind": "spinbox", "object": "whiteRoiHeightValue", "group": "White Reference > Region of interest", "visible": true, "default": "0", "min": 0, "max": 99, "step": 1},
    {"label": "Manual White Balance", "kind": "check", "object": "mwbGroupBox", "group": "White Reference", "visible": true, "default": "Off"},
    {"label": "Red", "kind": "spinbox", "object": "mwbRedValue", "group": "White Reference > Manual White Balance", "visible": true, "default": "1.000000", "min": 1e-06, "max": 1, "step": 0.05, "decimals": 6, "slider": true},
    {"label": "Green", "kind": "spinbox", "object": "mwbGreenValue", "group": "White Reference > Manual White Balance", "visible": true, "default": "1.000000", "min": 1e-06, "max": 1, "step": 0.05, "decimals": 6, "slider": true},
    {"label": "Blue", "kind": "spinbox", "object": "mwbBlueValue", "group": "White Reference > Manual White Balance", "visible": true, "default": "1.000000", "min": 1e-06, "max": 1, "step": 0.05, "decimals": 6, "slider": true},
    {"label": "Output White Reference Mask", "kind": "check", "object": "outputWhiteReferenceMask", "group": "White Reference", "visible": true, "default": "Off"},
    {"label": "Reference image", "kind": "combo", "object": "backgroundReferenceImageSelector", "group": "Background Reference", "visible": true, "default": "<--TARGET IMAGE-->", "options": ["<--TARGET IMAGE-->"]},
    {"label": "Lower Limit", "kind": "spinbox", "object": "backgroundLowerLimitValue", "group": "Background Reference", "visible": true, "default": "0.000000", "min": 0, "max": 1, "step": 0.05, "decimals": 6, "slider": true},
    {"label": "Upper Limit", "kind": "spinbox", "object": "backgroundUpperLimitValue", "group": "Background Reference", "visible": true, "default": "0.100000", "min": 0, "max": 1, "step": 0.05, "decimals": 6, "slider": true},
    {"label": "Region of interest", "kind": "check", "object": "backgroundRoiGroupBox", "group": "Background Reference", "visible": true, "default": "Off"},
    {"label": "Left", "kind": "spinbox", "object": "backgroundRoiLeftValue", "group": "Background Reference > Region of interest", "visible": true, "default": "0", "min": 0, "max": 99, "step": 1},
    {"label": "Top", "kind": "spinbox", "object": "backgroundRoiTopValue", "group": "Background Reference > Region of interest", "visible": true, "default": "0", "min": 0, "max": 99, "step": 1},
    {"label": "From Selection", "kind": "button", "object": "backgroundRoiSelectionButton", "group": "Background Reference > Region of interest", "visible": true, "default": "Off"},
    {"label": "Width", "kind": "spinbox", "object": "backgroundRoiWidthValue", "group": "Background Reference > Region of interest", "visible": true, "default": "0", "min": 0, "max": 99, "step": 1},
    {"label": "Height", "kind": "spinbox", "object": "backgroundRoiHeightValue", "group": "Background Reference > Region of interest", "visible": true, "default": "0", "min": 0, "max": 99, "step": 1},
    {"label": "Output Background Reference Mask", "kind": "check", "object": "outputBackgroundReferenceMask", "group": "Background Reference", "visible": true, "default": "Off"},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "Background Reference", "visible": true, "varies": ["default", "options"]},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
