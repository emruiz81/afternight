{
  "id": "multi_image_stacking.actionImage_Blend",
  "window": "Image Blend <{image}>",
  "controls": [
    {"label": "Zoom in", "kind": "toolbutton", "object": "zoomIn", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom out", "kind": "toolbutton", "object": "zoomOut", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom reset", "kind": "toolbutton", "object": "zoomReset", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Show grid", "kind": "toolbutton", "object": "gridButton", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Show clipping info", "kind": "toolbutton", "object": "showClippingInfo", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Absolute scales", "kind": "toolbutton", "object": "localChannelNormalization", "group": "", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Draw histogram areas", "kind": "toolbutton", "object": "showHistogramAreas", "group": "", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Show histogram", "kind": "toolbutton", "object": "showHistogram", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Plot resolution", "kind": "combo", "object": "plotResolution", "group": "", "visible": true, "default": "8-bit (256)", "options": ["6-bit (64)", "7-bit (128)", "8-bit (256)", "9-bit (512)", "10-bit (1024)", "12-bit (4096)", "14-bit (16K)", "16-bit (64K)", "100 levels", "1000 levels", "10000 levels"], "shared": "rt-preview"},
    {"label": "Image", "kind": "combo", "object": "targetImageSelector", "group": "Base image", "visible": true, "varies": ["default", "options"]},
    {"label": "Black Point", "kind": "spinbox", "object": "srcImageBlackPointValue", "group": "Base image > Stretch", "visible": true, "default": "0.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Highlights", "kind": "spinbox", "object": "srcImageHighlightsValue", "group": "Base image > Stretch", "visible": true, "default": "1.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Midtones", "kind": "spinbox", "object": "srcImageMidtonesValue", "group": "Base image > Stretch", "visible": true, "default": "0.5000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Image", "kind": "combo", "object": "secondImageSelector", "group": "Blend image", "visible": true, "default": "<--NO IMAGE-->", "options": ["<--NO IMAGE-->"]},
    {"label": "Black Point", "kind": "spinbox", "object": "imageBlendBlackPointValue", "group": "Blend image > Stretch", "visible": true, "default": "0.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Highlights", "kind": "spinbox", "object": "imageBlendHighlightsValue", "group": "Blend image > Stretch", "visible": true, "default": "1.0000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Midtones", "kind": "spinbox", "object": "imageBlendMidtonesValue", "group": "Blend image > Stretch", "visible": true, "default": "0.5000", "min": 0, "max": 1, "step": 0.01, "decimals": 4, "slider": true},
    {"label": "Filter Type", "kind": "combo", "object": "filterSelector", "group": "Blend image > Filter", "visible": true, "default": "None", "options": ["None", "Gaussian Blur", "High Pass", "Hue", "Color"]},
    {"label": "Radius", "kind": "spinbox", "object": "filterRadiusValue", "group": "Blend image > Filter", "visible": false, "default": "10.000", "min": 0.1, "max": 1000, "step": 0.01, "decimals": 3, "slider": true},
    {"label": "Saturation", "kind": "spinbox", "object": "filterSaturationValue", "group": "Blend image > Filter", "visible": false, "default": "1.000", "min": 0, "max": 1, "step": 0.01, "decimals": 3, "slider": true},
    {"label": "Hue", "kind": "spinbox", "object": "filterHueValue", "group": "Blend image > Filter", "visible": false, "default": "0.000", "min": 0, "max": 360, "step": 0.01, "decimals": 3, "slider": true},
    {"label": "Opacity", "kind": "spinbox", "object": "opacityValue", "group": "Blend image", "visible": true, "default": "1.0000", "min": 0, "max": 1, "step": 0.05, "decimals": 4, "slider": true},
    {"label": "Blend mode", "kind": "combo", "object": "blendMode", "group": "Blend parameters", "visible": true, "default": "Replace", "options": ["Replace", "Darken/Min", "Multiply", "Color Burn", "Linear Burn", "Darker Color", "Lighten/Max", "Screen", "Color Dodge", "Linear Dodge/Add", "Lighter Color", "Overlay", "Soft Light", "Hard Light", "Vivid Light", "Linear Light", "Pin Light", "Difference", "Exclusion", "Subtract", "Divide", "Power", "Arctan", "Hue", "Saturation", "Color", "Lightness"]},
    {"label": "Preserve lightness", "kind": "check", "object": "preserveLightness", "group": "Blend parameters", "visible": true, "default": "Off"},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "OK", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
