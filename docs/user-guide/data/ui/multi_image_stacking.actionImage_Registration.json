{
  "id": "multi_image_stacking.actionImage_Registration",
  "window": "Image Registration",
  "controls": [
    {"label": "Method", "kind": "combo", "object": "registrationMethodSelector", "group": "Registration", "visible": true, "default": "Star Matching", "options": ["Star Matching", "Phase Correlation", "Comet / Asteroid Tracking"]},
    {"label": "Transformation", "kind": "combo", "object": "transformationSelector", "group": "Registration", "visible": true, "default": "Homography", "options": ["Similarity", "Affine", "Homography", "Polynomial 2", "Polynomial 3", "Polynomial 4", "Auto"]},
    {"label": "Reference", "kind": "combo", "object": "referenceModeSelector", "group": "Registration", "visible": true, "default": "Manual", "options": ["Manual", "Auto"]},
    {"label": "Reference", "kind": "spinbox", "object": "referenceImageValue", "group": "Registration", "visible": true, "default": "1", "min": 1, "max": 100000, "step": 1},
    {"label": "Min Star Pairs", "kind": "spinbox", "object": "minStarParirsValue", "group": "Registration", "visible": true, "default": "10", "min": 5, "max": 10000, "step": 1},
    {"label": "Max Stars per Frame", "kind": "spinbox", "object": "maxStarParirsValue", "group": "Registration", "visible": true, "default": "2000", "min": 10, "max": 20000, "step": 1},
    {"label": "Auto-solve unsolved frames", "kind": "check", "object": "autoSolveUnsolvedFramesCheck", "group": "Registration", "visible": true, "default": "Off"},
    {"label": "Enrich with Gaia catalog", "kind": "check", "object": "enrichWithGaiaCatalogCheck", "group": "Registration", "visible": true, "default": "Off"},
    {"label": "Chromatic aberration correction", "kind": "check", "object": "chromaticAberrationCorrectionCheck", "group": "Registration", "visible": true, "default": "Off"},
    {"label": "Skip already-registered frames", "kind": "check", "object": "reprocessAlreadyRegisteredmages", "group": "Registration", "visible": true, "default": "On"},
    {"label": "Clear Registered Data", "kind": "button", "object": "clearRegisteredDataButton", "group": "Registration", "visible": true, "default": ""},
    {"label": "Register", "kind": "button", "object": "registerButton", "group": "Registration", "visible": true, "default": ""},
    {"label": "Standard / Mosaic / Intersection", "kind": "radio", "object": "alignModeStandard", "group": "Alignment", "visible": true, "default": "Standard", "options": ["Standard", "Mosaic", "Intersection"]},
    {"label": "Interpolation", "kind": "combo", "object": "interpolationSelector", "group": "Alignment", "visible": true, "default": "Auto", "options": ["Auto", "Nearest Neighbor", "Bilinear", "Bicubic", "Pixel Area Relation", "Lanczos4", "Bit Exact Bilinear", "Bit Exact Nearest Neighbor"]},
    {"label": "Align", "kind": "button", "object": "alignButton", "group": "Alignment", "visible": true, "default": ""},
    {"label": "Extended Settings...", "kind": "button", "object": "advancedSettingsButton", "group": "", "visible": true, "default": ""},
    {"label": "Browse", "kind": "button", "object": "outputDirectoryButton", "group": "Output Directory", "visible": true, "default": ""},
    {"label": "Add", "kind": "button", "object": "addFiles", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Add Folder", "kind": "button", "object": "addFolder", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Remove", "kind": "button", "object": "removeSelected", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Remove Failed", "kind": "button", "object": "removeFailedImagesButton", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Move frame up", "kind": "button", "object": "moveUpButton", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Move frame down", "kind": "button", "object": "moveDownButton", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Next Failed", "kind": "button", "object": "nextFailedButton", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Blink Compare...", "kind": "button", "object": "blinkCompareButton", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Clear All", "kind": "button", "object": "clearAll", "group": "Frame List", "visible": true, "default": ""},
    {"label": "Min Stars", "kind": "spinbox", "object": "", "group": "Advanced > Quality Thresholds", "visible": false, "default": "0", "min": 0, "max": 100000, "step": 1},
    {"label": "Max FWHM", "kind": "spinbox", "object": "", "group": "Advanced > Quality Thresholds", "visible": false, "default": "0.000", "min": 0, "max": 999, "step": 0.1, "decimals": 3},
    {"label": "Max Eccentricity", "kind": "spinbox", "object": "", "group": "Advanced > Quality Thresholds", "visible": false, "default": "0.000", "min": 0, "max": 1, "step": 0.01, "decimals": 3},
    {"label": "Apply Thresholds", "kind": "button", "object": "", "group": "Advanced > Quality Thresholds", "visible": false, "default": ""},
    {"label": "Reset", "kind": "button", "object": "", "group": "Advanced > Quality Thresholds", "visible": false, "default": ""},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
