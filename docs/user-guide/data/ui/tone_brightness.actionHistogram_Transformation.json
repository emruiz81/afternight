{
  "id": "tone_brightness.actionHistogram_Transformation",
  "window": "Histogram Transformation <{image}>",
  "controls": [
    {"label": "Zoom in", "kind": "toolbutton", "object": "zoomIn", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom out", "kind": "toolbutton", "object": "zoomOut", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom reset", "kind": "toolbutton", "object": "zoomReset", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Show grid", "kind": "toolbutton", "object": "gridButton", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Show transfer curve", "kind": "toolbutton", "object": "transferCurve", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Absolute scales", "kind": "toolbutton", "object": "localChannelNormalization", "group": "", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Draw histogram areas", "kind": "toolbutton", "object": "showHistogramAreas", "group": "", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Plot resolution", "kind": "combo", "object": "plotResolution", "group": "", "visible": true, "default": "8-bit (256)", "options": ["6-bit (64)", "7-bit (128)", "8-bit (256)", "9-bit (512)", "10-bit (1024)", "12-bit (4096)", "14-bit (16K)", "16-bit (64K)", "100 levels", "1000 levels", "10000 levels"], "shared": "rt-preview"},
    {"label": "Channel", "kind": "combo", "object": "channelSelector2", "group": "", "visible": true, "default": "RGB", "options": ["RGB", "Red", "Green", "Blue"]},
    {"label": "Auto-stretch linked channels", "kind": "toolbutton", "object": "autostretchLinked", "group": "", "visible": true, "default": ""},
    {"label": "Auto-stretch channels independently", "kind": "toolbutton", "object": "autostretchUnlinked", "group": "", "visible": true, "default": ""},
    {"label": "Shadows", "kind": "spinbox", "object": "shadowsValue", "group": "", "visible": true, "default": "0.000000", "min": 0, "max": 1, "step": 0.01, "decimals": 6},
    {"label": "Highlights", "kind": "spinbox", "object": "highlightsValue", "group": "", "visible": true, "default": "1.000000", "min": 0, "max": 1, "step": 0.01, "decimals": 6},
    {"label": "Midtones", "kind": "spinbox", "object": "midtonesValue", "group": "", "visible": true, "default": "0.500000", "min": 0, "max": 1, "step": 0.01, "decimals": 6},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
