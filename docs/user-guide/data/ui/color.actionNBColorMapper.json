{
  "id": "color.actionNBColorMapper",
  "window": "NB Color Mapper <{image}>",
  "controls": [
    {"label": "Zoom in", "kind": "toolbutton", "object": "zoomIn", "group": "Histogram Controls", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom out", "kind": "toolbutton", "object": "zoomOut", "group": "Histogram Controls", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom reset", "kind": "toolbutton", "object": "zoomReset", "group": "Histogram Controls", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Show grid", "kind": "toolbutton", "object": "gridButton", "group": "Histogram Controls", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Show clipping info", "kind": "toolbutton", "object": "showClippingInfo", "group": "Histogram Controls", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Absolute scales", "kind": "toolbutton", "object": "localChannelNormalization", "group": "Histogram Controls", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Draw histogram areas", "kind": "toolbutton", "object": "showHistogramAreas", "group": "Histogram Controls", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Show histogram", "kind": "toolbutton", "object": "showHistogram", "group": "Histogram Controls", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Plot resolution", "kind": "combo", "object": "plotResolution", "group": "Histogram Controls", "visible": true, "default": "8-bit (256)", "options": ["6-bit (64)", "7-bit (128)", "8-bit (256)", "9-bit (512)", "10-bit (1024)", "12-bit (4096)", "14-bit (16K)", "16-bit (64K)", "100 levels", "1000 levels", "10000 levels"], "shared": "rt-preview"},
    {"label": "Midtones", "kind": "spinbox", "object": "layerMidtones", "group": "Histogram Controls", "visible": true, "default": "0.500", "min": 0.001, "max": 0.999, "step": 0.01, "decimals": 3},
    {"label": "Blackpoint", "kind": "spinbox", "object": "layerBlackpoint", "group": "Histogram Controls", "visible": true, "default": "0.000", "min": 0, "max": 1, "step": 0.001, "decimals": 3},
    {"label": "Add", "kind": "button", "object": "addLayerButton", "group": "Layers", "visible": true, "default": ""},
    {"label": "Remove", "kind": "button", "object": "removeLayerButton", "group": "Layers", "visible": true, "default": ""},
    {"label": "Image", "kind": "combo", "object": "layerImageSelector", "group": "Layer Settings", "visible": true, "varies": ["default", "options"]},
    {"label": "Include layer", "kind": "check", "object": "layerInclude", "group": "Layer Settings", "visible": true, "default": "On"},
    {"label": "Hue", "kind": "spinbox", "object": "layerHue", "group": "Color Controls", "visible": true, "default": "0.000", "min": 0, "max": 359.99, "step": 1, "decimals": 3},
    {"label": "Saturation", "kind": "spinbox", "object": "layerSaturation", "group": "Color Controls", "visible": true, "default": "0.500", "min": 0, "max": 1, "step": 0.01, "decimals": 3},
    {"label": "Mode", "kind": "combo", "object": "modificationMode", "group": "Modification Controls", "visible": true, "default": "None", "options": ["None", "Add", "Multiply", "Boost"]},
    {"label": "With layer", "kind": "combo", "object": "modificationLayerSelector", "group": "Modification Controls", "visible": true, "default": "None", "options": ["None"]},
    {"label": "Factor", "kind": "spinbox", "object": "modificationFactor", "group": "Modification Controls", "visible": true, "default": "1.00", "min": 0, "max": 10, "step": 0.05, "decimals": 2},
    {"label": "Invert modifier", "kind": "check", "object": "modificationInvert", "group": "Modification Controls", "visible": true, "default": "Off"},
    {"label": "Median offset", "kind": "check", "object": "modificationMedianOffset", "group": "Modification Controls", "visible": true, "default": "Off"},
    {"label": "Enable", "kind": "check", "object": "backgroundEnabled", "group": "Background Neutralization", "visible": true, "default": "Off"},
    {"label": "Rescale high", "kind": "check", "object": "backgroundRescaleHigh", "group": "Background Neutralization", "visible": true, "default": "Off"},
    {"label": "Lower sigma", "kind": "spinbox", "object": "backgroundLowerSigma", "group": "Background Neutralization", "visible": true, "default": "-2.80", "min": -10, "max": 10, "step": 0.1, "decimals": 2},
    {"label": "Upper sigma", "kind": "spinbox", "object": "backgroundUpperSigma", "group": "Background Neutralization", "visible": true, "default": "2.00", "min": -10, "max": 10, "step": 0.1, "decimals": 2},
    {"label": "Preview STF", "kind": "check", "object": "applyPreviewStf", "group": "Output Options", "visible": true, "default": "On"},
    {"label": "STF target", "kind": "spinbox", "object": "stfTargetBackground", "group": "Output Options", "visible": true, "default": "0.250", "min": 0.01, "max": 0.99, "step": 0.01, "decimals": 3},
    {"label": "Create colorized layer images", "kind": "check", "object": "returnColorizedLayers", "group": "Output Options", "visible": true, "default": "Off"},
    {"label": "Apply STF to combined output", "kind": "check", "object": "applyStfToCombinedOutput", "group": "Output Options", "visible": true, "default": "Off"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
