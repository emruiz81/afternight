{
  "id": "sharpening_enhancement.actionUnsharp_Mask",
  "window": "Unsharp Mask <{image}>",
  "controls": [
    {"label": "Radius", "kind": "spinbox", "object": "radiusValue", "group": "", "visible": true, "default": "1.00", "min": 0, "max": 10, "step": 0.1, "decimals": 2, "slider": true},
    {"label": "Amount", "kind": "spinbox", "object": "amountValue", "group": "", "visible": true, "default": "1.00", "min": -10, "max": 10, "step": 0.1, "decimals": 2, "slider": true},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Channel", "kind": "combo", "object": "channelSelector", "group": "", "visible": true, "default": "RGB", "options": ["RGB", "Red", "Green", "Blue", "CIE L* (Lightness)", "CIE a*", "CIE b*", "CIE c*", "CIE h*", "CIE X", "CIE Y (Luminance)", "CIE Z", "HSL Hue", "HSL Saturation", "HSL Lightness", "HSV Hue", "HSV Saturation", "HSV Value", "YCbCr Luma", "YCbCr Blue Chroma", "YCbCr Red Chroma"]},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
