{
  "id": "color.actionNBRGB_Combination",
  "window": "NBRGB Combination <{image}>",
  "controls": [
    {"label": "Zoom in", "kind": "toolbutton", "object": "zoomIn", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom out", "kind": "toolbutton", "object": "zoomOut", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Zoom reset", "kind": "toolbutton", "object": "zoomReset", "group": "", "visible": true, "default": "", "shared": "rt-preview"},
    {"label": "Show grid", "kind": "toolbutton", "object": "gridButton", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Show clipping info", "kind": "toolbutton", "object": "showClippingInfo", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Absolute scales", "kind": "toolbutton", "object": "localChannelNormalization", "group": "", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Draw histogram areas", "kind": "toolbutton", "object": "showHistogramAreas", "group": "", "visible": true, "default": "Off", "shared": "rt-preview"},
    {"label": "Show histogram", "kind": "toolbutton", "object": "showHistogram", "group": "", "visible": true, "default": "On", "shared": "rt-preview"},
    {"label": "Plot resolution", "kind": "combo", "object": "plotResolution", "group": "", "visible": true, "default": "8-bit (256)", "options": ["6-bit (64)", "7-bit (128)", "8-bit (256)", "9-bit (512)", "10-bit (1024)", "12-bit (4096)", "14-bit (16K)", "16-bit (64K)", "100 levels", "1000 levels", "10000 levels"], "shared": "rt-preview"},
    {"label": "RGB", "kind": "combo", "object": "rgbImageSelector", "group": "Sources", "visible": true, "varies": ["default", "options"]},
    {"label": "RGB bandwidth", "kind": "spinbox", "object": "rgbBandwidth", "group": "Sources", "visible": true, "default": "100.00", "min": 0.1, "max": 1000, "step": 1, "decimals": 2},
    {"label": "Red", "kind": "combo", "object": "redImageSelector", "group": "Narrowband Channels", "visible": true, "default": "<--NO IMAGE-->", "options": ["<--NO IMAGE-->"]},
    {"label": "Red", "kind": "spinbox", "object": "redBandwidth", "group": "Narrowband Channels", "visible": true, "default": "7.00", "min": 0.1, "max": 500, "step": 0.5, "decimals": 2},
    {"label": "Red", "kind": "spinbox", "object": "redScale", "group": "Narrowband Channels", "visible": true, "default": "1.20", "min": 0, "max": 10, "step": 0.05, "decimals": 2},
    {"label": "Green", "kind": "combo", "object": "greenImageSelector", "group": "Narrowband Channels", "visible": true, "default": "<--NO IMAGE-->", "options": ["<--NO IMAGE-->"]},
    {"label": "Green", "kind": "spinbox", "object": "greenBandwidth", "group": "Narrowband Channels", "visible": true, "default": "8.50", "min": 0.1, "max": 500, "step": 0.5, "decimals": 2},
    {"label": "Green", "kind": "spinbox", "object": "greenScale", "group": "Narrowband Channels", "visible": true, "default": "1.20", "min": 0, "max": 10, "step": 0.05, "decimals": 2},
    {"label": "Blue", "kind": "combo", "object": "blueImageSelector", "group": "Narrowband Channels", "visible": true, "default": "<--NO IMAGE-->", "options": ["<--NO IMAGE-->"]},
    {"label": "Blue", "kind": "spinbox", "object": "blueBandwidth", "group": "Narrowband Channels", "visible": true, "default": "8.50", "min": 0.1, "max": 500, "step": 0.5, "decimals": 2},
    {"label": "Blue", "kind": "spinbox", "object": "blueScale", "group": "Narrowband Channels", "visible": true, "default": "1.20", "min": 0, "max": 10, "step": 0.05, "decimals": 2},
    {"label": "Reject low", "kind": "spinbox", "object": "rejectLow", "group": "Options", "visible": true, "default": "0.000", "min": 0, "max": 1, "step": 0.01, "decimals": 3},
    {"label": "Reject high", "kind": "spinbox", "object": "rejectHigh", "group": "Options", "visible": true, "default": "0.920", "min": 0, "max": 1, "step": 0.01, "decimals": 3},
    {"label": "Non Linear rescale", "kind": "check", "object": "nonLinearRescale", "group": "Options", "visible": true, "default": "Off"},
    {"label": "Preview", "kind": "combo", "object": "previewDisplayMode", "group": "Options", "visible": true, "default": "NBRGB", "options": ["NBRGB", "RGB", "NBr", "NBg", "NBb"]},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
