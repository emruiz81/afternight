{
  "id": "color.actionSpectrophotometric_Color_Calibration",
  "window": "Spectrophotometric Color Calibration <{image}>",
  "controls": [
    {"label": "Sensor", "kind": "combo", "object": "spccProcessResponseSensorCombo", "group": "", "visible": false, "default": "", "options": []},
    {"label": "OSC filter", "kind": "combo", "object": "spccProcessResponseFilterCombo", "group": "", "visible": false, "default": "", "options": []},
    {"label": "DSLR LPF", "kind": "combo", "object": "spccProcessResponseLpfCombo", "group": "", "visible": false, "default": "", "options": []},
    {"label": "Red filter", "kind": "combo", "object": "spccProcessResponseMonoRedFilterCombo", "group": "", "visible": false, "default": "", "options": []},
    {"label": "Green filter", "kind": "combo", "object": "spccProcessResponseMonoGreenFilterCombo", "group": "", "visible": false, "default": "", "options": []},
    {"label": "Blue filter", "kind": "combo", "object": "spccProcessResponseMonoBlueFilterCombo", "group": "", "visible": false, "default": "", "options": []},
    {"label": "Response profile", "kind": "combo", "object": "spccProcessResponseProfileCombo", "group": "", "visible": false, "default": "", "options": []},
    {"label": "White reference", "kind": "combo", "object": "spccProcessWhiteReferenceCombo", "group": "", "visible": false, "default": "", "options": []},
    {"label": "Open Catalogs Data...", "kind": "button", "object": "spccProcessManageCatalogsDataButton", "group": "", "visible": true, "default": ""},
    {"label": "Download Offline Catalog", "kind": "button", "object": "spccProcessDownloadFullCatalogButton", "group": "", "visible": true, "default": ""},
    {"label": "Download Needed Region", "kind": "button", "object": "spccProcessDownloadNeededRegionButton", "group": "", "visible": false, "default": ""},
    {"label": "Download Response Profiles", "kind": "button", "object": "spccProcessDownloadResponseProfilesButton", "group": "", "visible": true, "default": ""},
    {"label": "Assign Image State", "kind": "button", "object": "spccProcessAssignImageStateButton", "group": "", "visible": true, "default": ""},
    {"label": "Choose magnitude limit automatically", "kind": "check", "object": "spccAutoMagnitudeLimitCheck", "group": "Catalog and WCS Preflight", "visible": false, "default": "On"},
    {"label": "Magnitude cap", "kind": "spinbox", "object": "spccMagnitudeLimitSpin", "group": "Catalog and WCS Preflight", "visible": false, "default": "17.6", "min": 6, "max": 20, "step": 0.1, "decimals": 1},
    {"label": "Match radius (arcsec)", "kind": "spinbox", "object": "spccMatchRadiusSpin", "group": "Catalog and WCS Preflight", "visible": false, "default": "5.0", "min": 0.5, "max": 30, "step": 0.5, "decimals": 1},
    {"label": "Max detected stars", "kind": "spinbox", "object": "spccMaxSourcesSpin", "group": "Catalog and WCS Preflight", "visible": false, "default": "4096", "min": 64, "max": 20000, "step": 256},
    {"label": "Detected star SNR", "kind": "spinbox", "object": "spccSourceSnrSpin", "group": "Catalog and WCS Preflight", "visible": false, "default": "5.0", "min": 1, "max": 100, "step": 0.5, "decimals": 1},
    {"label": "Max residual (px)", "kind": "spinbox", "object": "spccResidualPxSpin", "group": "Catalog and WCS Preflight", "visible": false, "default": "3.0", "min": 0.1, "max": 20, "step": 0.1, "decimals": 1},
    {"label": "Max residual (arcsec)", "kind": "spinbox", "object": "spccResidualArcsecSpin", "group": "Catalog and WCS Preflight", "visible": false, "default": "3.0", "min": 0.1, "max": 30, "step": 0.1, "decimals": 1},
    {"label": "Minimum samples", "kind": "spinbox", "object": "spccMinimumSamplesSpin", "group": "Photometry and Fit", "visible": false, "default": "35", "min": 5, "max": 500, "step": 1},
    {"label": "FWHM aperture scale", "kind": "spinbox", "object": "spccApertureScaleSpin", "group": "Photometry and Fit", "visible": false, "default": "2.0", "min": 0.5, "max": 5, "step": 0.1, "decimals": 1},
    {"label": "Annulus sigma clip", "kind": "spinbox", "object": "spccAnnulusSigmaClipSpin", "group": "Photometry and Fit", "visible": false, "default": "3.0", "min": 1, "max": 8, "step": 0.1, "decimals": 1},
    {"label": "Outlier policy", "kind": "combo", "object": "spccFitOutlierPolicyCombo", "group": "Photometry and Fit", "visible": false, "default": "AfterNight iterative", "options": ["AfterNight iterative", "Single-pass"]},
    {"label": "Fit outlier sigma", "kind": "spinbox", "object": "spccOutlierSigmaSpin", "group": "Photometry and Fit", "visible": false, "default": "3.0", "min": 1, "max": 8, "step": 0.1, "decimals": 1},
    {"label": "Fit iterations", "kind": "spinbox", "object": "spccFitIterationsSpin", "group": "Photometry and Fit", "visible": false, "default": "4", "min": 1, "max": 20, "step": 1},
    {"label": "Apply background neutralization", "kind": "check", "object": "spccBackgroundNeutralizationCheck", "group": "Photometry and Fit", "visible": false, "default": "On"},
    {"label": "Target image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
