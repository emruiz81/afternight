{
  "id": "denoising.actionNon_Local_Bayes_Filter",
  "window": "Non-Local Bayes <{image}>",
  "controls": [
    {"label": "Sigma", "kind": "spinbox", "object": "sigmaValue", "group": "", "visible": true, "default": "5.0000", "min": 0.001, "max": 50, "step": 0.1, "decimals": 4, "slider": true},
    {"label": "Automatic Sigma Estimation", "kind": "check", "object": "autoSigma", "group": "", "visible": true, "default": "On"},
    {"label": "1° Step Homogeneous Area", "kind": "check", "object": "useArea1", "group": "", "visible": true, "default": "On"},
    {"label": "2° Step Homogeneous Area", "kind": "check", "object": "useArea2", "group": "", "visible": true, "default": "Off"},
    {"label": "Data Adaptive Dual Domain Denoise (DA3D)", "kind": "check", "object": "da3d", "group": "", "visible": true, "default": "Off"},
    {"label": "Anscombe Variance-Stabilizing Transform", "kind": "check", "object": "anscombe", "group": "", "visible": true, "default": "Off"},
    {"label": "SOS Iterations", "kind": "spinbox", "object": "sosIterations", "group": "", "visible": true, "default": "1", "min": 1, "max": 8, "step": 1},
    {"label": "SOS Rho", "kind": "spinbox", "object": "sosRhoValue", "group": "", "visible": true, "default": "0.80", "min": 0.01, "max": 0.99, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Amount", "kind": "spinbox", "object": "amountValue", "group": "", "visible": true, "default": "1.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Channel", "kind": "combo", "object": "channelSelector", "group": "", "visible": true, "default": "RGB", "options": ["RGB", "Red", "Green", "Blue", "CIE L* (Lightness)", "CIE a*", "CIE b*", "CIE c*", "CIE h*", "CIE X", "CIE Y (Luminance)", "CIE Z", "HSL Hue", "HSL Saturation", "HSL Lightness", "HSV Hue", "HSV Saturation", "HSV Value", "YCbCr Luma", "YCbCr Blue Chroma", "YCbCr Red Chroma"]},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
