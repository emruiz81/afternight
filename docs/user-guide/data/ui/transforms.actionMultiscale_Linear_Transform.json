{
  "id": "transforms.actionMultiscale_Linear_Transform",
  "window": "Multiscale Linear Transform <{image}>",
  "controls": [
    {"label": "Algorithm", "kind": "combo", "object": "algorithmComboBox", "group": "Transform Settings", "visible": true, "default": "Multiscale Linear Transform", "options": ["Starlet Transform", "Multiscale Linear Transform"]},
    {"label": "Detail Layers", "kind": "spinbox", "object": "numLayersSpinBox", "group": "Transform Settings", "visible": true, "default": "6", "min": 1, "max": 11, "step": 1},
    {"label": "Layer Spacing", "kind": "combo", "object": "spacingComboBox", "group": "Transform Settings", "visible": true, "default": "Dyadic", "options": ["Dyadic", "Linear"]},
    {"label": "Linear Scale", "kind": "spinbox", "object": "linearScaleSpinBox", "group": "Transform Settings", "visible": false, "default": "1", "min": 1, "max": 16, "step": 1},
    {"label": "Scaling Function", "kind": "combo", "object": "scalingFunctionComboBox", "group": "Transform Settings", "visible": true, "default": "B3 Spline (5)", "options": ["Linear Interpolation (3)", "B3 Spline (5)", "Gaussian (5)", "Gaussian (7)", "Gaussian (9)", "Gaussian (11)", "Small Scale 3 (3)", "Small Scale 4 (3)", "Small Scale 5 (3)", "Small Scale 6 (3)", "Small Scale 8 (3)", "Small Scale 12 (3)", "Small Scale 16 (3)", "Small Scale 24 (3)", "Small Scale 32 (3)"]},
    {"label": "Amount", "kind": "spinbox", "object": "amountSpinBox", "group": "Transform Settings", "visible": true, "default": "1.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Enable All", "kind": "button", "object": "enableAllLayersButton", "group": "Layers", "visible": true, "default": ""},
    {"label": "Disable All", "kind": "button", "object": "disableAllLayersButton", "group": "Layers", "visible": true, "default": ""},
    {"label": "Reset Biases", "kind": "button", "object": "resetBiasesButton", "group": "Layers", "visible": true, "default": ""},
    {"label": "Linear Mask", "kind": "check", "object": "linearMaskGroup", "group": "Global Settings", "visible": true, "default": "Off"},
    {"label": "Amplification", "kind": "spinbox", "object": "linearMaskAmplificationSpinBox", "group": "Global Settings > Linear Mask", "visible": true, "default": "100", "min": 1, "max": 300, "step": 1, "slider": true},
    {"label": "Smoothness", "kind": "spinbox", "object": "linearMaskSmoothnessSpinBox", "group": "Global Settings > Linear Mask", "visible": true, "default": "1.00", "min": 0, "max": 10, "step": 0.1, "decimals": 2, "slider": true},
    {"label": "Preview Mask", "kind": "check", "object": "linearMaskPreviewCheckBox", "group": "Global Settings > Linear Mask", "visible": true, "default": "Off"},
    {"label": "Inverted", "kind": "check", "object": "linearMaskInvertCheckBox", "group": "Global Settings > Linear Mask", "visible": true, "default": "On"},
    {"label": "k-Sigma Thresholding", "kind": "check", "object": "ksigmaGroup", "group": "Global Settings", "visible": true, "default": "Off"},
    {"label": "Threshold (k)", "kind": "spinbox", "object": "ksigmaKSpinBox", "group": "Global Settings > k-Sigma Thresholding", "visible": true, "default": "3.00", "min": 0, "max": 10, "step": 0.1, "decimals": 2, "slider": true},
    {"label": "Amount", "kind": "spinbox", "object": "ksigmaAmountSpinBox", "group": "Global Settings > k-Sigma Thresholding", "visible": true, "default": "1.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Soft Threshold", "kind": "check", "object": "ksigmaSoftCheckBox", "group": "Global Settings > k-Sigma Thresholding", "visible": true, "default": "On"},
    {"label": "Use MRS", "kind": "check", "object": "ksigmaUseMrsCheckBox", "group": "Global Settings > k-Sigma Thresholding", "visible": true, "default": "Off"},
    {"label": "Deringing", "kind": "check", "object": "deringingGroup", "group": "Global Settings", "visible": true, "default": "Off"},
    {"label": "Dark", "kind": "spinbox", "object": "deringingDarkSpinBox", "group": "Global Settings > Deringing", "visible": true, "default": "0.10", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Bright", "kind": "spinbox", "object": "deringingBrightSpinBox", "group": "Global Settings > Deringing", "visible": true, "default": "0.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Output Deringing Maps", "kind": "check", "object": "deringingOutputMapsCheckBox", "group": "Global Settings > Deringing", "visible": true, "default": "Off"},
    {"label": "Mode", "kind": "combo", "object": "lstfModeComboBox", "group": "Global Settings > Large-Scale Transfer Function", "visible": true, "default": "None", "options": ["None", "Hyperbolic", "Log10", "Natural Log (ln)"]},
    {"label": "Breakpoint", "kind": "spinbox", "object": "lstfBreakpointSpinBox", "group": "Global Settings > Large-Scale Transfer Function", "visible": false, "default": "0.75", "min": 0.1, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Low Range", "kind": "spinbox", "object": "dreLowSpinBox", "group": "Global Settings > Dynamic Range Extension", "visible": true, "default": "0.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "High Range", "kind": "spinbox", "object": "dreHighSpinBox", "group": "Global Settings > Dynamic Range Extension", "visible": true, "default": "0.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Enabled", "kind": "check", "object": "layerEnabledCheckBox", "group": "Selected Layer", "visible": true, "default": "On"},
    {"label": "Copy to All", "kind": "button", "object": "copyToAllButton", "group": "Selected Layer", "visible": true, "default": ""},
    {"label": "Reset Layer", "kind": "button", "object": "resetCurrentLayerButton", "group": "Selected Layer", "visible": true, "default": ""},
    {"label": "Bias", "kind": "spinbox", "object": "biasSpinBox", "group": "Selected Layer", "visible": true, "default": "0.00", "min": -1, "max": 15, "step": 0.01, "decimals": 2, "slider": true},
    {"label": "Noise Reduction", "kind": "check", "object": "layerNrGroup", "group": "Selected Layer", "visible": true, "default": "Off"},
    {"label": "Threshold (σ)", "kind": "spinbox", "object": "nrThresholdSpinBox", "group": "Selected Layer > Noise Reduction", "visible": true, "default": "3.00", "min": 0, "max": 40, "step": 0.1, "decimals": 2, "slider": true},
    {"label": "Amount", "kind": "spinbox", "object": "nrAmountSpinBox", "group": "Selected Layer > Noise Reduction", "visible": true, "default": "1.00", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Iterations", "kind": "spinbox", "object": "nrIterationsSpinBox", "group": "Selected Layer > Noise Reduction", "visible": true, "default": "1", "min": 1, "max": 10, "step": 1},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Channel", "kind": "combo", "object": "channelSelector", "group": "", "visible": true, "default": "RGB", "options": ["RGB", "Red", "Green", "Blue", "CIE L* (Lightness)", "CIE a*", "CIE b*", "CIE c*", "CIE h*", "CIE X", "CIE Y (Luminance)", "CIE Z", "HSL Hue", "HSL Saturation", "HSL Lightness", "HSV Hue", "HSV Saturation", "HSV Value", "YCbCr Luma", "YCbCr Blue Chroma", "YCbCr Red Chroma"]},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "Preview", "kind": "combo", "object": "previewModeComboBox", "group": "", "visible": true, "default": "Processed Image", "options": ["Processed Image", "Layer (All Changes)", "Layer (Increasing Pixels)", "Layer (Decreasing Pixels)"]},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
