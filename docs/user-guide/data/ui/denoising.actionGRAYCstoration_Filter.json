{
  "id": "denoising.actionGRAYCstoration_Filter",
  "window": "GRAYCstoration <{image}>",
  "controls": [
    {"label": "Iterations", "kind": "spinbox", "object": "iterationsValue", "group": "", "visible": true, "default": "1", "min": 1, "max": 10, "step": 1, "slider": true},
    {"label": "Amplitude", "kind": "spinbox", "object": "amplitudeValue", "group": "", "visible": true, "default": "60", "min": 0, "max": 100, "step": 1, "slider": true},
    {"label": "Sharpness", "kind": "spinbox", "object": "sharpnessValue", "group": "", "visible": true, "default": "0.70", "min": 0, "max": 2.5, "step": 0.01, "decimals": 2, "slider": true},
    {"label": "Anisotropy", "kind": "spinbox", "object": "anisotropyValue", "group": "", "visible": true, "default": "0.30", "min": 0, "max": 1, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Noise Scale", "kind": "spinbox", "object": "noiseScaleValue", "group": "", "visible": true, "default": "0.60", "min": 0, "max": 3, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Regularity", "kind": "spinbox", "object": "regularityValue", "group": "", "visible": true, "default": "1.10", "min": 0, "max": 3, "step": 0.05, "decimals": 2, "slider": true},
    {"label": "Spatial Step Size", "kind": "spinbox", "object": "spatialStepSizeValue", "group": "", "visible": true, "default": "0.80", "min": 0.1, "max": 1, "step": 0.01, "decimals": 2, "slider": true},
    {"label": "Angular Step Size", "kind": "spinbox", "object": "angularStepSizeValue", "group": "", "visible": true, "default": "30", "min": 1, "max": 90, "step": 1, "slider": true},
    {"label": "Precision", "kind": "spinbox", "object": "precisionValue", "group": "", "visible": true, "default": "2.00", "min": 0.1, "max": 10, "step": 0.1, "decimals": 2, "slider": true},
    {"label": "Amount", "kind": "spinbox", "object": "amountValue", "group": "", "visible": true, "default": "1.00", "min": 0, "max": 1, "step": 0.01, "decimals": 2, "slider": true},
    {"label": "Interpolation", "kind": "combo", "object": "interpolationSelector", "group": "", "visible": true, "default": "Nearest Neighbor", "options": ["Nearest Neighbor", "Linear", "Runge-Kutta"]},
    {"label": "Fast Approximation", "kind": "check", "object": "fastApproximation", "group": "", "visible": true, "default": "On"},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Channel", "kind": "combo", "object": "channelSelector", "group": "", "visible": true, "default": "RGB", "options": ["RGB", "Red", "Green", "Blue", "CIE L* (Lightness)", "CIE a*", "CIE b*", "CIE c*", "CIE h*", "CIE X", "CIE Y (Luminance)", "CIE Z", "HSL Hue", "HSL Saturation", "HSL Lightness", "HSV Hue", "HSV Saturation", "HSV Value", "YCbCr Luma", "YCbCr Blue Chroma", "YCbCr Red Chroma"]},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
