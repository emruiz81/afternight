    {"label": "Zoom Out", "kind": "toolbutton", "object": "anFloatingToolbarZoomOut", "group": "Canvas", "visible": true, "default": ""},
    {"label": "Zoom In", "kind": "toolbutton", "object": "anFloatingToolbarZoomIn", "group": "Canvas", "visible": true, "default": ""},
    {"label": "Zoom 100%", "kind": "toolbutton", "object": "anFloatingToolbarZoom100", "group": "Canvas", "visible": true, "default": ""},
