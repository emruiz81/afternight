    {"label": "Upper bound", "kind": "spinbox", "object": "upperBoundValue", "group": "Settings", "visible": true, "default": "1.00000000", "min": 0, "max": 1, "step": 0.01, "decimals": 8},
    {"label": "outputModeSelector", "kind": "combo", "object": "outputModeSelector", "group": "Settings", "visible": true, "default": "Replace target image", "options": ["Replace target image", "Create new image"]},
    {"label": "New Image Id", "kind": "field", "object": "newImadeIdEdit", "group": "Settings", "visible": true, "default": "PIXEL_MATH_IMAGE"},
    {"label": "Width", "kind": "spinbox", "object": "widthValue", "group": "Settings", "visible": true, "default": "0", "min": 0, "max": 12000, "step": 1},
    {"label": "Height", "kind": "spinbox", "object": "heightValue", "group": "Settings", "visible": true, "default": "0", "min": 0, "max": 12000, "step": 1},
    {"label": "Color space", "kind": "combo", "object": "colorSpaceSelector", "group": "Settings", "visible": true, "default": "As target", "options": ["As target", "Grayscale", "RGB", "RGBA"]},
    {"label": "Color format", "kind": "combo", "object": "colorFormatSelector", "group": "Settings", "visible": true, "default": "As target", "options": ["As target", "8 bits", "16 bits", "32 bits int", "32 bits float", "64 bits float"]},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
