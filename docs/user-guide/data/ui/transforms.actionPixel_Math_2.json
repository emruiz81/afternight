    {"label": "Global Symbols (Comma separated list)", "kind": "field", "object": "globalSymbolsTextEdit", "group": "Symbols", "visible": true, "default": ""},
    {"label": "Use a single RGB/K expression", "kind": "check", "object": "useSingleRGBKExpression", "group": "", "visible": true, "default": "On"},
    {"label": "Import", "kind": "button", "object": "importButton", "group": "", "visible": true, "default": ""},
    {"label": "Export", "kind": "button", "object": "exportButton", "group": "", "visible": true, "default": ""},
    {"label": "Single threaded", "kind": "check", "object": "singleThreaded", "group": "Settings", "visible": true, "default": "Off"},
    {"label": "Process in 64 bits", "kind": "check", "object": "processIn64Bits", "group": "Settings", "visible": true, "default": "On"},
    {"label": "Code optimization", "kind": "check", "object": "codeOptimization", "group": "Settings", "visible": true, "default": "On"},
