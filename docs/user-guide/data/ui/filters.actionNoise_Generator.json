{
  "id": "filters.actionNoise_Generator",
  "window": "Noise Generator <{image}>",
  "controls": [
    {"label": "Noise Type", "kind": "combo", "object": "noiseTypeSelector", "group": "", "visible": true, "default": "Gaussian", "options": ["Gaussian", "LocalVar", "Poisson", "Salt", "Pepper", "Salt & Pepper", "Speckle"]},
    {"label": "Mean", "kind": "spinbox", "object": "meanValue", "group": "", "visible": true, "default": "0.0000", "min": 0, "max": 0.5, "step": 0.005, "decimals": 4, "slider": true},
    {"label": "Var", "kind": "spinbox", "object": "varValue", "group": "", "visible": true, "default": "0.0020", "min": 0, "max": 0.5, "step": 0.001, "decimals": 4, "slider": true},
    {"label": "Amount", "kind": "spinbox", "object": "amountValue", "group": "", "visible": true, "default": "0.0200", "min": 0, "max": 0.5, "step": 0.001, "decimals": 4, "slider": true},
    {"label": "Salt vs Pepper", "kind": "spinbox", "object": "saltVsPepperValue", "group": "", "visible": true, "default": "0.50", "min": 0, "max": 1, "step": 0.01, "decimals": 2, "slider": true},
    {"label": "Target Image", "kind": "combo", "object": "targetImageSelector", "group": "", "visible": true, "varies": ["default", "options"]},
    {"label": "Channel", "kind": "combo", "object": "channelSelector", "group": "", "visible": true, "default": "RGB", "options": ["RGB", "Red", "Green", "Blue", "CIE L* (Lightness)", "CIE a*", "CIE b*", "CIE c*", "CIE h*", "CIE X", "CIE Y (Luminance)", "CIE Z", "HSL Hue", "HSL Saturation", "HSL Lightness", "HSV Hue", "HSV Saturation", "HSV Value", "YCbCr Luma", "YCbCr Blue Chroma", "YCbCr Red Chroma"]},
    {"label": "Preview", "kind": "check", "object": "preview", "group": "", "visible": true, "default": "On"},
    {"label": "Close", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Reset", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"},
    {"label": "Apply", "kind": "button", "object": "", "group": "", "visible": true, "default": "", "shared": "process-window"}
  ]
}
